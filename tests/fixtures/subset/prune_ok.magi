# a1 = 3 against 1, 2, 4, 8, 16: the upfront count (15 subsets) exceeds 14, but the sum
# target prunes: 5 subsets of one row, then only 1 and 2 extend (at most 4 + 3)
source pa = csv("prune_a.csv") { identity id }
source pb = csv("budget_b.csv") { identity id }

reconcile prune = pa as a with pb as b {
    block by none
    tier sums {
        subset b max_items 2 max_subsets 14
        require sum(b.amount) == a.amount
    }
}

export prune.matches to "out/prune_matches.csv"
