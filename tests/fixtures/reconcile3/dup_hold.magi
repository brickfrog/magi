# `duplicates hold|continue` for many_to_one / one_to_many. B rows 1 and 2 are exact duplicates.
# The early A row picks B row 1 in tier `early` and passes over B row 2; the late A row accepts
# any B row in tier `late`.
#   m2o_hold / o2m_hold: the passed-over row is a held duplicate, so `late` matches nothing
#   m2o_continue:        the passed-over row stays available and `late` matches it
#   picked:              another chooser picks the passed-over row, so it is not held (consume a
#                        keeps B rows available to `late`)
source dh_a = csv("dh_a.csv") { identity id }
source dh_b = csv("dh_b.csv") { identity id }

dataset early_late = dh_a |> filter kind != "pick2"

reconcile m2o_hold = early_late as a with dh_b as b {
    cardinality many_to_one
    duplicates hold
    block by none
    tier early { require a.kind == "early" and a.amt == b.amt }
    tier late { require a.kind == "late" and a.amt == b.amt }
}

reconcile m2o_continue = early_late as a with dh_b as b {
    cardinality many_to_one
    duplicates continue
    block by none
    tier early { require a.kind == "early" and a.amt == b.amt }
    tier late { require a.kind == "late" and a.amt == b.amt }
}

reconcile o2m_hold = dh_b as a with early_late as b {
    cardinality one_to_many
    duplicates hold
    block by none
    tier early { require b.kind == "early" and a.amt == b.amt }
    tier late { require b.kind == "late" and a.amt == b.amt }
}

reconcile picked = dh_a as a with dh_b as b {
    cardinality many_to_one
    consume a
    duplicates hold
    block by none
    tier early {
        require a.amt == b.amt
        require a.kind == "early" or (a.kind == "pick2" and b.id == 2)
    }
    tier late { require a.kind == "late" and b.id == 2 }
}

export m2o_hold.matches to "out/m2o_hold_matches.csv"
export m2o_hold.unmatched_a to "out/m2o_hold_unmatched_a.csv"
export m2o_hold.unmatched_b to "out/m2o_hold_unmatched_b.csv"
export m2o_continue.matches to "out/m2o_continue_matches.csv"
export m2o_continue.unmatched_b to "out/m2o_continue_unmatched_b.csv"
export o2m_hold.matches to "out/o2m_hold_matches.csv"
export o2m_hold.unmatched_a to "out/o2m_hold_unmatched_a.csv"
export o2m_hold.unmatched_b to "out/o2m_hold_unmatched_b.csv"
export picked.matches to "out/picked_matches.csv"
export picked.unmatched_b to "out/picked_unmatched_b.csv"
