# rec.magi over a ledger export with one more column
source ledger = csv("ledger_note.csv") {
    identity id
    schema {
        id: string
        amount: decimal(10, 2)
        day: date
        note: string?
    }
}

source bank = csv("bank.csv") { identity ref }

reconcile rec = ledger as a with bank as b {
    cardinality one_to_one
    tier exact {
        block by amount
        require a.day == b.day
    }
}

export rec.matches to "out/matches.csv"
